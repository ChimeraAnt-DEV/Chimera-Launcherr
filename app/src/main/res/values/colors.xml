<resources>
    <!--
        GlowberryClient brand palette.

        One violet/magenta/amber identity, not the inherited Bedrock green/cyan. These
        tokens are the single source of truth: screens reference them (or the theme
        attributes that resolve to them) instead of embedding their own gradient hex.
    -->
    <color name="primary">#6236E8</color>
    <color name="on_primary">#FFFFFF</color>

    <color name="secondary">#A82E9E</color>
    <color name="on_secondary">#FFFFFF</color>

    <color name="primary_container">#E9E2FF</color>
    <color name="on_primary_container">#2A1370</color>

    <color name="tertiary">#B4690E</color>
    <color name="on_tertiary">#FFFFFF</color>

    <color name="error">#D93025</color>
    <color name="on_error">#FFFFFF</color>

    <color name="background">#F7F5FF</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#EFEBFF</color>
    <color name="on_background">#1A1730</color>
    <color name="on_surface">#1A1730</color>
    <color name="on_surface_variant">#4A4368</color>

    <color name="outline">#CFC9E8</color>
    <color name="card_border">#E4DFF5</color>
    <color name="white">#FFFFFF</color>
    <color name="divider">#E4DFF5</color>

    <color name="scrim">#66000000</color>

    <!-- Brand glows replace the old green/cyan pair. -->
    <color name="glow_violet">#A88CFF</color>
    <color name="glow_magenta">#E070C0</color>

    <color name="abi_label_text">#000000</color>
    <color name="accent_text">#6236E8</color>

    <color name="text_primary">#1A1730</color>
    <color name="text_secondary">#6B6580</color>
    <color name="qa_icon_color">#000000</color>
    <color name="ic_launcher_adaptive_back">#F2EFFF</color>

    <!-- Brand accents (formerly accent_purple / accent_blue / primary_dark). -->
    <color name="accent_violet">#6D4AFF</color>
    <color name="accent_sky">#4A7CFF</color>
    <color name="brand_header_start">#2A1370</color>
    <color name="brand_header_end">#6236E8</color>

    <!-- Glassmorphism Colors -->
    <color name="glass_background">#33FFFFFF</color>
    <color name="glass_background_elevated">#44FFFFFF</color>
    <color name="glass_border">#55FFFFFF</color>

    <!-- Section gradient accent palette (all derive from the brand palette). -->
    <color name="grad_hero_start">#4A24C8</color>
    <color name="grad_hero_end">#8E2E82</color>
    <color name="grad_launch_start">#4A2BD6</color>
    <color name="grad_launch_end">#7A3FE8</color>
    <color name="grad_versions_start">#1A6D4AFF</color>
    <color name="grad_versions_end">#0A6D4AFF</color>
    <color name="grad_mods_start">#1AA82E9E</color>
    <color name="grad_mods_end">#0AA82E9E</color>
    <color name="grad_content_start">#1A4A7CFF</color>
    <color name="grad_content_end">#0A4A7CFF</color>
    <color name="grad_pulse_glow">#2B6D4AFF</color> <!-- brand violet at 17% alpha -->

    <!-- Additional UI Colors -->
    <color name="background_dark">#121212</color>
    <color name="surface_dark">#1E1E1E</color>
    <color name="text_secondary_light">#B0B0B0</color>
    <color name="divider_dark">#333333</color>
    <color name="on_surface_light">#FFFFFF</color>

    <!-- The header gradient runs brand_header_start to brand_header_end, so its text is
         always light rather than following on_primary (which flips in night mode). -->
    <color name="on_header_gradient">#FFFFFF</color>
    <color name="on_header_gradient_secondary">#DCD3F5</color>

    <!-- The hero gradient stays a deep violet to plum in both themes so light text reads on
         it; the tokens exist so callers do not pick text_secondary_light by hand. -->
    <color name="on_hero_card">#FFFFFF</color>
    <color name="on_hero_card_secondary">#E9E0FF</color>

    <!--
        Alpha tints of the brand violet. These exist because Android colour resources cannot
        express "primary at 10% alpha": every chip, badge and toggle that wants a translucent
        brand wash names one of these instead of embedding the raw ARGB literal, so a palette
        change is still a one-file edit.
    -->
    <color name="brand_primary_0">#006236E8</color>
    <color name="brand_primary_6">#106236E8</color>
    <color name="brand_primary_10">#1A6236E8</color>
    <color name="brand_primary_13">#206236E8</color>
    <color name="brand_primary_20">#336236E8</color>
    <color name="brand_primary_24">#3D6236E8</color>
    <color name="brand_primary_33">#556236E8</color>
    <color name="brand_primary_67">#AA6236E8</color>
    <color name="brand_primary_87">#DD6236E8</color>
    <color name="brand_indigo_67">#AA6D4AFF</color>

</resources>