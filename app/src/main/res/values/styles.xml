<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppFullScreenTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fontFamily">@font/misans</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu_square</item>
        <item name="android:listDivider">@drawable/divider_menu_item</item>
    </style>

    <style name="PopupAccountSwitch_Animation">
        <item name="android:windowEnterAnimation">@anim/popup_in</item>
        <item name="android:windowExitAnimation">@anim/popup_out</item>
    </style>

    <!--
        Root of the Chimera widget style namespace. The dotted names below infer their
        parents from it, so it must exist even though it carries no attributes itself.
    -->
    <style name="Widget.Chimera" parent="" />

    <!--
        One tab in the top navigation bar. A single TextView carrying its icon via
        drawableStart, so the icon tints with the label (see BaseActivity.setActiveNavTab).
        paddingHorizontal sits in a dimen where a w600dp override widens it: on a phone the
        icon-only tabs need generous padding to stay tappable, while a tablet with full labels
        wants them tighter so six entries fit without scrolling.
    -->
    <style name="Widget.Chimera.NavTab" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/nav_tab_padding</item>
        <item name="android:fontFamily">@font/misans</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:drawablePadding">@dimen/nav_tab_drawable_padding</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!--
        The single card style. Every card surface uses one of these three variants so the
        radius, border and elevation cannot drift screen to screen.

        Widget.Chimera.Card.<X> is the shared base; the concrete styles differ only in the
        view they must attach to (CardView vs MaterialCardView vs a plain container).
        Use the varianted style that matches the view class, not a hand-rolled background.
    -->
    <style name="Widget.Chimera.Card" parent="">
        <item name="android:background">@drawable/chimera_card</item>
        <item name="android:elevation">@dimen/chimera_card_elevation</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>

    <style name="Widget.Chimera.Card.Compact">
        <item name="android:background">@drawable/chimera_card_small</item>
        <item name="android:padding">@dimen/chimera_card_padding_compact</item>
    </style>

    <!-- For androidx.cardview.widget.CardView callers: radius/fill/stroke live on the card. -->
    <style name="Widget.Chimera.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/chimera_card_radius</item>
        <item name="cardElevation">@dimen/chimera_card_elevation</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>

    <!-- For MaterialCardView callers: same token set, Material attributes. -->
    <style name="Widget.Chimera.MaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/chimera_card_radius</item>
        <item name="cardElevation">@dimen/chimera_card_elevation</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">@dimen/chimera_card_border_width</item>
        <item name="cardUseCompatPadding">false</item>
        <item name="android:padding">@dimen/chimera_card_padding</item>
    </style>
</resources>
