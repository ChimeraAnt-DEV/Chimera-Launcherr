<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. The foreground art is pre-scaled into the 66dp safe zone of the
    108dp canvas, so no <inset> is applied here: stacking an inset on top of pre-scaled art
    would shrink the mark twice and leave it stranded mid-tile.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@drawable/ic_launcher_background" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_mono" />
</adaptive-icon>
