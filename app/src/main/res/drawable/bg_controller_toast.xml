<?xml version="1.0" encoding="utf-8"?>
<!--
    The controller-toast glass panel. Uses the shared card radius tokens so it reads as part of
    the same surface system, with a translucent fill so the content behind it shows through.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glass_background_elevated" />
    <corners android:radius="@dimen/chimera_card_radius" />
    <stroke
        android:width="@dimen/chimera_card_border_width"
        android:color="@color/glass_border" />
</shape>
