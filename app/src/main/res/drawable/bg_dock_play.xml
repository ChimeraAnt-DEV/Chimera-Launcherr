<?xml version="1.0" encoding="utf-8"?>
<!--
    The dock's Play button: a vibrant violet-to-magenta gradient with a 16dp radius. Uses the
    theme primary so it follows the wallpaper accent, and the fixed brand header end so the
    gradient always has a second colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="?attr/colorPrimary"
        android:endColor="@color/brand_header_end"
        android:angle="0" />
    <corners android:radius="16dp" />
</shape>
