<?xml version="1.0" encoding="utf-8"?>
<!--
    A section header for the VIP module grid. The group's colour is a 3dp bar on the left of the
    label, mirroring the accent strips the launcher uses for its own section headers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:defaultFocusHighlightEnabled="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="14dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <View
        android:id="@+id/vip_group_bar"
        android:layout_width="3dp"
        android:layout_height="14dp"
        android:background="#7C5CFF" />

    <TextView
        android:id="@+id/vip_group_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:letterSpacing="0.14"
        android:textColor="#B6B0CC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true" />
</LinearLayout>
