<?xml version="1.0" encoding="utf-8"?>
<!--
    The Voice tab. Landscape-only like the rest of the app, so the layout is a two-column
    Split: the left column owns "you" (master switch, your channel and its members, creating
    a channel), the right column owns discovery (the live public directory and join-by-code).
    Neither column is a fixed height, so the screen grows with font scale.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp">

        <TextView
            android:id="@+id/voice_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_voice"
            android:fontFamily="@font/misans"
            android:textColor="@color/primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/voice_master_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/voice_master_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:thumbTint="@color/primary"
            android:trackTint="#555555" />

    </LinearLayout>

    <TextView
        android:id="@+id/voice_scope_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:fontFamily="@font/misans"
        android:text="@string/voice_chat_scope_note"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <!-- You: channel, members, create -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <LinearLayout
                    style="@style/Widget.Chimera.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_current_channel"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/voice_channel_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/voice_channel_kind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/voice_members_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/voice_members_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/voice_copy_code_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:fontFamily="@font/misans"
                            android:text="@string/voice_copy_code"
                            android:textAllCaps="false"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/voice_share_code_button"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:minHeight="40dp"
                            android:fontFamily="@font/misans"
                            android:text="@string/voice_share_code"
                            android:textAllCaps="false"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/voice_leave_button"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="40dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/voice_leave_channel"
                        android:textAllCaps="false"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    style="@style/Widget.Chimera.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/voice_create_channel"
                        android:fontFamily="@font/misans"
                        android:textColor="@color/on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/voice_create_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="44dp"
                        android:background="@drawable/chimera_card_small"
                        android:hint="@string/voice_channel_name_hint"
                        android:fontFamily="@font/misans"
                        android:inputType="text"
                        android:maxLength="32"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/misans"
                            android:text="@string/voice_channel_private"
                            android:textColor="@color/on_surface"
                            android:textSize="14sp" />

                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/voice_create_private"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/primary"
                            android:trackTint="#555555" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/misans"
                        android:text="@string/voice_channel_private_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/voice_create_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minHeight="44dp"
                        android:backgroundTint="@color/primary"
                        android:fontFamily="@font/misans"
                        android:text="@string/voice_create_button"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Discovery: directory + join by code -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                style="@style/Widget.Chimera.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_join_by_code"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/voice_join_code"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="44dp"
                        android:background="@drawable/chimera_card_small"
                        android:hint="@string/voice_join_code_hint"
                        android:fontFamily="@font/misans"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="32"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="@color/on_surface"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/voice_join_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:minHeight="44dp"
                        android:backgroundTint="@color/primary"
                        android:fontFamily="@font/misans"
                        android:text="@string/voice_join_button"
                        android:textAllCaps="false"
                        android:textColor="@color/on_primary"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/Widget.Chimera.Card"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_public_directory"
                    android:fontFamily="@font/misans"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voice_directory_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/misans"
                    android:text="@string/voice_directory_empty"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Pull-to-refresh with the launcher's overshoot physics; no spinner. -->
                <org.chimeramc.client.ui.animation.OverscrollRefreshLayout
                    android:id="@+id/voice_directory_refresh"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="6dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scrollbars="none"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:id="@+id/voice_directory_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                    </ScrollView>

                </org.chimeramc.client.ui.animation.OverscrollRefreshLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
