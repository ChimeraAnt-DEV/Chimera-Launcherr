<?xml version="1.0" encoding="utf-8"?>
<!--
    One VIP module card.

    The chain is icon tile → name + section label → status pill, with the configure gear on the
    far right when the module has settings. Depth is a CardView elevation plus a group-tinted top
    strip, so a column of cards reads as a laid-out grid rather than a list of grey boxes.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vip_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="false"
    app:cardBackgroundColor="#1E1B2E"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardPreventCornerOverlap="true"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/vip_card_accent"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#7C5CFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="72dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/vip_card_icon_tile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_vip_icon_tile">

                <ImageView
                    android:id="@+id/vip_card_icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_modules"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/vip_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#F4F1FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/vip_card_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="#8B85A3"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/vip_card_unavailable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/vip_status_unavailable"
                    android:textColor="#FF5C7A"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/vip_card_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vip_status_off"
                android:gravity="center"
                android:minWidth="54dp"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/vip_status_off"
                android:textColor="#B6B0CC"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <ImageButton
                android:id="@+id/vip_card_config"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_vip_icon_button"
                android:contentDescription="@string/vip_configure"
                android:padding="8dp"
                android:src="@drawable/ic_settings"
                android:tint="#C9C3E0"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
